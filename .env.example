# Hyperlocal Food Marketplace Environment Configuration

# Database Connection (Default: SQLite for zero-config local run)
# For PostgreSQL with PostGIS, set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hyperlocal_food
DATABASE_URL=sqlite:///./hyperlocal_food.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Real-time WebSocket ping interval (seconds)
WS_HEARTBEAT_INTERVAL=25

# Geolocation Privacy Buffer (meters)
OBFUSCATION_RADIUS_METERS=160
